{
  "name": "catatuang",
  "version": "1.5.0",
  "private": true,
  "description": "CatatUang - Aplikasi pencatat keuangan Android offline-first berbasis Capacitor",
  "scripts": {
    "test": "node tests/run-tests.js",
    "lint": "eslint www/",
    "format": "prettier --write www/",
    "build": "node scripts/build.js",
    "set:build-version": "node scripts/set-build-version.js",
    "patch:android": "node scripts/patch-android.js",
    "android:sync": "npx cap sync android",
    "android:add": "npx cap add android",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "@eslint/js": "^9.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
